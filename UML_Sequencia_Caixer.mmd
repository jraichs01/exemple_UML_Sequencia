sequenceDiagram
    actor U as Usuari
    participant ATM as Interfície Caixer
    participant B as Sistema Bancari
    participant D as Dispensador

    U->>ATM: introduirPIN(1234)
    activate ATM
    ATM->>B: validarPIN(1234)
    activate B
    B-->>ATM: resposta (booleà)
    deactivate B

    alt PIN és correcte
        ATM-->>U: mostrar "Tria quantitat"
        U->>ATM: sol·licitarRetirada(50€)
        ATM->>B: verificarSaldo(50€)
        activate B
        B-->>ATM: saldoDisponible: true
        deactivate B
        ATM->>D: lliurarEfectiu(50€)
        D-->>ATM: dinersLliurats
        ATM-->>U: mostrar "Operació finalitzada"
    else PIN és incorrecte
        ATM-->>U: mostrar "Error: PIN incorrecte"
        ATM-->>U: retornar targeta
    end
    
    deactivate ATM